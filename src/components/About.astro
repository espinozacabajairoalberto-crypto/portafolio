---
import { profileConfig } from '../data/config';
import SectionTitle from './ui/SectionTitle.astro';
---

<section class="about-section section" id="sobre-mi">
  <div class="container">
    <SectionTitle
      badge="Sobre Mí"
      title="Perfil Académico y Enfoque"
      subtitle="Conoce mi trayectoria como estudiante de Ingeniería de Sistemas y las áreas tecnológicas en las que me apasiona profundizar."
    />

    <div class="about-grid">
      <!-- Columna Fotografía / Avatar -->
      <div class="about-image-wrapper reveal">
        <div class="image-card glass-card">
          <div class="image-frame">
            <img
              src={profileConfig.avatar}
              alt={`Fotografía de ${profileConfig.name}`}
              class="profile-img"
              loading="lazy"
            />
          </div>
          <!-- Badge flotante de estado -->
          <div class="image-badge">
            <div class="badge-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>
            <div class="badge-text">
              <span class="badge-title">Ingeniería de Sistemas</span>
              <span class="badge-subtitle">En formación continua</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Texto y Pilares -->
      <div class="about-info reveal">
        <h3 class="about-heading">
          Construyendo soluciones mediante software, datos e innovación
        </h3>
        
        <p class="about-text">
          {profileConfig.bioFull}
        </p>

        <!-- Tarjetas de pilares/enfoque -->
        <div class="about-pillars">
          <!-- Pilar 1 -->
          <div class="pillar-card glass-card">
            <div class="pillar-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <div class="pillar-content">
              <h4>Desarrollo de Software</h4>
              <p>Diseño y construcción de aplicaciones con código modular, arquitecturas limpias y buenas prácticas.</p>
            </div>
          </div>

          <!-- Pilar 2 -->
          <div class="pillar-card glass-card">
            <div class="pillar-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
            </div>
            <div class="pillar-content">
              <h4>Bases de Datos & Análisis</h4>
              <p>Modelado relacional eficiente, normalización, optimización de consultas SQL e integridad transaccional.</p>
            </div>
          </div>

          <!-- Pilar 3 -->
          <div class="pillar-card glass-card">
            <div class="pillar-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="pillar-content">
              <h4>Optimización & IoT</h4>
              <p>Aplicación de modelos matemáticos (Simplex), integración de hardware con Arduino y telemetría de sensores.</p>
            </div>
          </div>
        </div>

        <div class="about-actions">
          <a href="#contacto" class="btn btn-primary btn-sm">
            Escríbeme para colaborar
          </a>
          <a href="#habilidades" class="btn btn-secondary btn-sm">
            Ver todas mis habilidades
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3.5rem;
    align-items: center;
  }
  .about-image-wrapper {
    position: relative;
  }
  .image-card {
    padding: 1rem;
    border-radius: var(--radius-lg);
    position: relative;
    max-width: 420px;
    margin: 0 auto;
  }
  .image-frame {
    width: 100%;
    aspect-ratio: 4/4.5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: rgba(14, 14, 18, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }
  .image-card:hover .profile-img {
    transform: scale(1.03);
  }
  .image-badge {
    position: absolute;
    bottom: -15px;
    right: 20px;
    background: rgba(14, 14, 18, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-glow);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: var(--shadow-md);
  }
  .badge-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(239, 68, 68, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary);
  }
  .badge-text {
    display: flex;
    flex-direction: column;
  }
  .badge-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .badge-subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .about-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .about-heading {
    font-size: 1.75rem;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .about-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .about-pillars {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }
  .pillar-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
  }
  .pillar-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary);
    flex-shrink: 0;
  }
  .pillar-content h4 {
    font-size: 1rem;
    margin-bottom: 0.25rem;
    color: var(--text-primary);
  }
  .pillar-content p {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }
  .about-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .about-heading {
      font-size: 1.45rem;
    }
  }
  @media (max-width: 500px) {
    .about-actions {
      flex-direction: column;
    }
  }
</style>