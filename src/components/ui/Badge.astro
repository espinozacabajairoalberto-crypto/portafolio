---
interface Props {
  variant?: 'default' | 'tech' | 'success' | 'outline' | 'subject';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variantClasses = {
  default: 'badge',
  tech: 'badge badge-tech',
  success: 'badge badge-success',
  outline: 'badge badge-outline',
  subject: 'badge badge-subject'
};
---

<span class:list={[variantClasses[variant], className]}>
  <slot />
</span>

<style>
  .badge-outline {
    background: transparent;
    border-color: rgba(239, 68, 68, 0.4);
    color: #fca5a5;
  }
  .badge-subject {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    color: #e5e7eb;
  }
</style>