---
import type { Project } from '../types';
import Badge from './ui/Badge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const imageUrl = project.image.startsWith('http') ? project.image : `${baseUrl}${project.image.replace(/^\//, '')}`;
const projectUrl = `${baseUrl}proyectos/${project.slug}`;
---

<article class="project-card glass-card reveal" data-category={project.category} data-subject={project.subjectId || 'general'}>
  <!-- Imagen / Mockup del Proyecto -->
  <div class="project-image-wrapper">
    <img
      src={imageUrl}
      alt={`Captura o vista previa de ${project.title}`}
      class="project-img"
      loading="lazy"
    />
    <div class="image-overlay"></div>
    
    <!-- Badges Superiores -->
    <div class="card-badges">
      {project.category === 'academic' ? (
        <Badge variant="default">Académico</Badge>
      ) : (
        <Badge variant="outline">Personal</Badge>
      )}
      {project.subjectName && (
        <Badge variant="subject">{project.subjectName.split('/')[0].trim()}</Badge>
      )}
    </div>
  </div>

  <!-- Contenido de la Tarjeta -->
  <div class="project-content">
    <h3 class="project-title">
      <a href={projectUrl}>
        {project.title}
      </a>
    </h3>

    <p class="project-description">
      {project.description}
    </p>

    <!-- Lista de Tecnologías Utilizadas -->
    <div class="project-technologies">
      {project.technologies.slice(0, 4).map((tech) => (
        <Badge variant="tech">{tech}</Badge>
      ))}
      {project.technologies.length > 4 && (
        <Badge variant="tech">+{project.technologies.length - 4}</Badge>
      )}
    </div>

    <!-- Botones de Acción -->
    <div class="project-actions">
      <a href={projectUrl} class="btn btn-primary btn-sm card-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        Ver proyecto
      </a>

      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm icon-btn" title="Ver código en GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          GitHub
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 100%;
  }
  .project-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9.5;
    background: rgba(15, 23, 42, 0.8);
    overflow: hidden;
  }
  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth);
  }
  .project-card:hover .project-img {
    transform: scale(1.05);
  }
  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(7, 9, 14, 0.85) 100%);
  }
  .card-badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    z-index: 2;
  }
  .project-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .project-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    line-height: 1.35;
  }
  .project-title a {
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }
  .project-title a:hover {
    color: var(--accent-primary);
  }
  .project-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }
  .project-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }
  .card-btn {
    flex-grow: 1;
  }
  .icon-btn {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
</style>