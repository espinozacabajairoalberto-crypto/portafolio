---
import { skills, skillCategories } from '../data/skills';
import SectionTitle from './ui/SectionTitle.astro';
---

<section class="skills-section section" id="habilidades">
  <div class="container">
    <SectionTitle
      badge="Stack Tecnológico"
      title="Habilidades y Competencias"
      subtitle="Conjunto de lenguajes, frameworks, bases de datos y herramientas con las que he trabajado en proyectos académicos y prácticos."
    />

    <!-- Selector de Categorías -->
    <div class="skills-tabs reveal">
      <button class="tab-btn active" data-category="all">
        <span class="tab-indicator"></span>
        Todas ({skills.length})
      </button>
      {skillCategories.map((category) => {
        const count = skills.filter(s => s.category === category.id).length;
        return (
          <button class="tab-btn" data-category={category.id}>
            <span class="tab-indicator"></span>
            {category.label} ({count})
          </button>
        );
      })}
    </div>

    <!-- Grid de Habilidades -->
    <div class="skills-grid" id="skills-container">
      {skills.map((skill) => (
        <div class="skill-card glass-card reveal" data-category={skill.category}>
          <div class="skill-header">
            <div class="skill-icon-wrap">
              <span class="tech-tag-icon">&lt;/&gt;</span>
            </div>
            <div class="skill-meta">
              <h4 class="skill-name">{skill.name}</h4>
              <span class="skill-level-badge">{skill.level}</span>
            </div>
          </div>

          <!-- Indicador Visual Simple (Sin porcentajes inventados) -->
          <div class="level-indicator-container">
            <div class="level-dots" aria-label={`Nivel de experiencia: ${skill.level}`}>
              {[1, 2, 3, 4, 5].map((step) => (
                <span class:list={['level-dot', { active: step <= skill.levelNumber }]}></span>
              ))}
            </div>
            <span class="level-desc">{skill.level}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.75rem;
  }
  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .tab-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }
  .tab-btn.active {
    background: rgba(239, 68, 68, 0.16);
    border-color: var(--accent-primary);
    color: #ffffff;
    box-shadow: 0 0 15px rgba(239, 68, 68, 0.3);
  }
  .tab-btn.active .tab-indicator {
    background: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-primary);
  }
  .tab-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
    transition: all var(--transition-fast);
  }
  
  /* Grid de Habilidades */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.25rem;
  }
  .skill-card {
    padding: 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
  }
  .skill-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .skill-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .skill-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .skill-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .skill-level-badge {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  .level-indicator-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border-subtle);
  }
  .level-dots {
    display: flex;
    gap: 4px;
  }
  .level-dot {
    width: 14px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.1);
    transition: background var(--transition-normal);
  }
  .level-dot.active {
    background: var(--accent-primary);
    box-shadow: 0 0 6px rgba(239, 68, 68, 0.5);
  }
  .level-desc {
    font-size: 0.7rem;
    color: #fca5a5;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    .skill-card {
      padding: 1rem;
    }
  }
  @media (max-width: 400px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Filtrado de habilidades por categoría
  const tabButtons = document.querySelectorAll('.skills-tabs .tab-btn');
  const skillCards = document.querySelectorAll('#skills-container .skill-card');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle active state en botones
      tabButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const selectedCategory = btn.getAttribute('data-category');

      // Filtrar tarjetas
      skillCards.forEach(card => {
        const cardCategory = card.getAttribute('data-category');
        if (selectedCategory === 'all' || cardCategory === selectedCategory) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>