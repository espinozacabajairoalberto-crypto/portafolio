---
import { projects } from '../data/projects';
import SectionTitle from './ui/SectionTitle.astro';
import ProjectCard from './ProjectCard.astro';

const academicProjects = projects.filter(p => p.category === 'academic');
const personalProjects = projects.filter(p => p.category === 'personal');
---

<section class="projects-section section" id="proyectos">
  <div class="container">
    <SectionTitle
      badge="Portafolio de Trabajo"
      title="Proyectos Realizados"
      subtitle="Explora los sistemas, aplicaciones y modelos desarrollados tanto en materias universitarias como en iniciativas personales."
    />

    <!-- Selector de Categoría Principal -->
    <div class="project-filters reveal">
      <button class="filter-btn active" data-filter="all">
        Todos ({projects.length})
      </button>
      <button class="filter-btn" data-filter="academic">
        Proyectos Académicos ({academicProjects.length})
      </button>
      <button class="filter-btn" data-filter="personal">
        Proyectos Personales ({personalProjects.length})
      </button>
    </div>

    <!-- Banner informativo de proyectos personales -->
    <div class="personal-notice glass-card reveal" id="personal-notice" style="display: none;">
      <div class="notice-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      </div>
      <p class="notice-text">
        <strong>Sección de Proyectos Personales:</strong> Estas tarjetas están preparadas como plantillas/borradores para incorporar proyectos extracurriculares en curso (APIs, scripts de automatización, apps móviles y experimentos IoT).
      </p>
    </div>

    <!-- Grid Principal de Proyectos -->
    <div class="projects-grid" id="main-projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>

<style>
  .project-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  .filter-btn {
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .filter-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.2);
  }
  .filter-btn.active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
  }
  .personal-notice {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    margin-bottom: 2rem;
    border-left: 4px solid var(--accent-cyan);
    background: rgba(6, 182, 212, 0.08);
  }
  .notice-icon {
    color: var(--accent-cyan);
    flex-shrink: 0;
  }
  .notice-text {
    font-size: 0.88rem;
    color: #cbd5e1;
    line-height: 1.5;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>

<script>
  // Filtro de proyectos
  const filterBtns = document.querySelectorAll('.project-filters .filter-btn');
  const projectCards = document.querySelectorAll('#main-projects-grid .project-card');
  const personalNotice = document.getElementById('personal-notice');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      // Mostrar/ocultar aviso de proyectos personales
      if (personalNotice) {
        personalNotice.style.display = filter === 'personal' ? 'flex' : 'none';
      }

      projectCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>