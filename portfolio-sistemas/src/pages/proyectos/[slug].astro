---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../types';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout
  title={`${project.title} | Proyecto - Ingeniería de Sistemas`}
  description={project.description}
  image={project.image}
>
  <div class="project-detail-page">
    <div class="container project-detail-container">
      
      <!-- Botón Volver -->
      <div class="back-nav reveal">
        <a href="/#proyectos" class="btn btn-secondary btn-sm back-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Volver a proyectos
        </a>
      </div>

      <!-- Cabecera del Proyecto -->
      <header class="project-header reveal">
        <div class="header-badges">
          {project.category === 'academic' ? (
            <Badge variant="default">Proyecto Académico</Badge>
          ) : (
            <Badge variant="outline">Proyecto Personal</Badge>
          )}
          {project.subjectName && (
            <Badge variant="subject">{project.subjectName}</Badge>
          )}
        </div>

        <h1 class="project-page-title">{project.title}</h1>
        <p class="project-lead">{project.description}</p>
      </header>

      <!-- Banner Principal / Mockup -->
      <div class="project-hero-media glass-card reveal">
        <img
          src={project.image}
          alt={`Vista general de ${project.title}`}
          class="hero-media-img"
        />
      </div>

      <!-- Enlaces Rápidos y Repositorio -->
      <div class="project-quick-actions reveal">
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            Ver repositorio en GitHub
          </a>
        )}
        {project.demoUrl && (
          <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Ver Demo en Vivo
          </a>
        )}
      </div>

      <!-- Contenido Estructurado en 2 Columnas -->
      <div class="project-body-grid">
        
        <!-- Columna Principal -->
        <div class="project-main-info">
          
          <!-- Problema Identificado -->
          {project.problem && (
            <section class="info-block glass-card reveal">
              <div class="block-header">
                <div class="block-icon alert-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </div>
                <h3 class="block-title">Problema Identificado</h3>
              </div>
              <p class="block-text">{project.problem}</p>
            </section>
          )}

          <!-- Objetivo -->
          {project.objective && (
            <section class="info-block glass-card reveal">
              <div class="block-header">
                <div class="block-icon goal-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                </div>
                <h3 class="block-title">Objetivo del Proyecto</h3>
              </div>
              <p class="block-text">{project.objective}</p>
            </section>
          )}

          <!-- Solución Desarrollada -->
          {project.solution && (
            <section class="info-block glass-card reveal">
              <div class="block-header">
                <div class="block-icon solution-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <h3 class="block-title">Solución Desarrollada</h3>
              </div>
              <p class="block-text">{project.solution}</p>
            </section>
          )}

          <!-- Características Principales -->
          {project.features && project.features.length > 0 && (
            <section class="info-block glass-card reveal">
              <div class="block-header">
                <div class="block-icon feature-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </div>
                <h3 class="block-title">Características Clave</h3>
              </div>
              <ul class="features-list">
                {project.features.map((feature) => (
                  <li class="feature-item">
                    <span class="feature-bullet">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <!-- Resultados -->
          {project.results && project.results.length > 0 && (
            <section class="info-block glass-card reveal">
              <div class="block-header">
                <div class="block-icon result-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <h3 class="block-title">Resultados Obtenidos</h3>
              </div>
              <ul class="results-list">
                {project.results.map((res) => (
                  <li class="result-item">{res}</li>
                ))}
              </ul>
            </section>
          )}

          <!-- Aprendizajes Adquiridos -->
          {project.learnings && project.learnings.length > 0 && (
            <section class="info-block glass-card reveal">
              <div class="block-header">
                <div class="block-icon learn-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
                <h3 class="block-title">Aprendizajes Técnicos</h3>
              </div>
              <ul class="learnings-list">
                {project.learnings.map((learn) => (
                  <li class="learn-item">{learn}</li>
                ))}
              </ul>
            </section>
          )}

        </div>

        <!-- Columna Lateral (Sidebar) -->
        <aside class="project-sidebar">
          
          <!-- Card de Tecnologías -->
          <div class="sidebar-card glass-card reveal">
            <h4 class="sidebar-title">Tecnologías Utilizadas</h4>
            <div class="tech-stack-wrap">
              {project.technologies.map((tech) => (
                <Badge variant="tech">{tech}</Badge>
              ))}
            </div>
          </div>

          <!-- Card de Información de la Materia -->
          {project.subjectName && (
            <div class="sidebar-card glass-card reveal">
              <h4 class="sidebar-title">Contexto Académico</h4>
              <div class="sidebar-field">
                <span class="field-label">Materia / Asignatura</span>
                <span class="field-value">{project.subjectName}</span>
              </div>
              <div class="sidebar-field">
                <span class="field-label">Tipo de Proyecto</span>
                <span class="field-value">Ingeniería de Sistemas</span>
              </div>
            </div>
          )}

          <!-- Card de Acción Rápida -->
          <div class="sidebar-card cta-card glass-card reveal">
            <h4 class="sidebar-title">¿Interesado en este proyecto?</h4>
            <p class="cta-desc">Puedes revisar el código fuente completo o contactarme para conocer más detalles sobre la arquitectura.</p>
            <a href="/#contacto" class="btn btn-primary btn-full btn-sm">
              Contactarme
            </a>
          </div>

        </aside>

      </div>

      <!-- Navegación Inferior -->
      <div class="bottom-nav reveal">
        <a href="/#proyectos" class="btn btn-secondary">
          ← Volver al listado de proyectos
        </a>
      </div>

    </div>
  </div>
</Layout>

<style>
  .project-detail-page {
    padding-top: calc(var(--header-height) + 2rem);
    padding-bottom: 5rem;
  }
  .project-detail-container {
    max-width: 1050px;
  }
  .back-nav {
    margin-bottom: 2rem;
  }
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .project-header {
    margin-bottom: 2.5rem;
  }
  .header-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .project-page-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  .project-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 800px;
  }
  .project-hero-media {
    width: 100%;
    aspect-ratio: 16 / 8.5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 2rem;
    background: #0d1117;
  }
  .hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .project-body-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
    align-items: flex-start;
  }
  .project-main-info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .info-block {
    padding: 1.75rem;
    border-radius: var(--radius-md);
  }
  .block-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .block-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .alert-icon {
    background: rgba(239, 68, 68, 0.12);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  .goal-icon {
    background: rgba(239, 68, 68, 0.1);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.25);
  }
  .solution-icon {
    background: rgba(255, 255, 255, 0.05);
    color: #e5e7eb;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .feature-icon {
    background: rgba(239, 68, 68, 0.1);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.25);
  }
  .result-icon {
    background: rgba(255, 255, 255, 0.05);
    color: #e5e7eb;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .learn-icon {
    background: rgba(239, 68, 68, 0.12);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  .block-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .block-text {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }
  .features-list, .results-list, .learnings-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .feature-bullet {
    color: var(--accent-primary);
    font-weight: 800;
    flex-shrink: 0;
  }
  .result-item, .learn-item {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .result-item::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-primary);
    font-weight: 700;
  }
  .learn-item::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: #f87171;
  }
  
  /* Sidebar */
  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-card {
    padding: 1.5rem;
    border-radius: var(--radius-md);
  }
  .sidebar-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }
  .tech-stack-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sidebar-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.85rem;
  }
  .sidebar-field:last-child {
    margin-bottom: 0;
  }
  .field-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
  }
  .field-value {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 600;
  }
  .cta-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .btn-full {
    width: 100%;
  }
  .bottom-nav {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: center;
  }

  @media (max-width: 860px) {
    .project-body-grid {
      grid-template-columns: 1fr;
    }
    .project-page-title {
      font-size: 2rem;
    }
  }
</style>